#!/usr/bin/env bash
# omarchy-we — use Wallpaper Engine wallpapers as live Omarchy wallpapers.
#
# Renders Steam Workshop "Wallpaper Engine" wallpapers (scene / video) on the
# Hyprland background layer via linux-wallpaperengine, and keeps Omarchy's own
# Quickshell background out of the way by pointing it at a transparent image.
#
#   omarchy-we list                 List available wallpapers (index / type / title / id)
#   omarchy-we set [--all|--screen <m>] <query>  Set on the focused monitor (default), or all / one
#   omarchy-we menu                 Pick a wallpaper from a graphical menu
#   omarchy-we next | prev | random Cycle wallpapers
#   omarchy-we launch               (Re)launch the saved wallpaper — used by autostart & hooks
#   omarchy-we current [--json]     Show the current wallpaper (--json for machine output)
#   omarchy-we list [--json]        List wallpapers (--json emits id/title/type/preview)
#   omarchy-we stop                 Stop the live wallpaper and restore a normal Omarchy background
#   omarchy-we resume               Bring back the last live wallpaper after a stop
#   omarchy-we screen [<monitor> <query>|clear]  Per-monitor override (no args: show mapping)
#   omarchy-we ipc <verb>           Stable interface for bars/plugins: version|picker|entries|current|set|stop
#
set -euo pipefail

# ---- paths -----------------------------------------------------------------
WE_BIN="linux-wallpaperengine"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-we"
STATE_FILE="$STATE_DIR/current"
SCREENS_FILE="$STATE_DIR/screens"   # optional per-monitor overrides
STOPPED_FILE="$STATE_DIR/stopped"   # present after `stop`: autostart/hooks must not relaunch
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-we"
PREVIEW_DIR="$CACHE_DIR/previews"       # symlinks: "<label>.<ext>" -> wallpaper preview
MAP_FILE="$CACHE_DIR/map.tsv"           # "<label>\t<workshop-id>"
TRANSPARENT_BG="$HOME/.config/omarchy/backgrounds/transparent.png"
SCALING="${OMARCHY_WE_SCALING:-fill}"    # stretch | fit | fill | default
FPS="${OMARCHY_WE_FPS:-}"                 # optional frame-rate cap
SCOPE="${OMARCHY_WE_SCOPE:-focused}"     # focused | all — what `set`/next/prev/random/Omatrix change
# The picker's last tile stops the live wallpaper. Its label leads with ⏹ (a
# high codepoint) so it sorts after every wallpaper title in the grid.
STOP_LABEL="⏹ Stop Live Wallpaper"
STOP_SENTINEL="__STOP__"
mkdir -p "$STATE_DIR"

# Steam Workshop content for Wallpaper Engine (app id 431960).
find_workshop() {
  local c
  for c in \
    "$HOME/.local/share/Steam/steamapps/workshop/content/431960" \
    "$HOME/.steam/steam/steamapps/workshop/content/431960" \
    "$HOME/.var/app/com.valvesoftware.Steam/data/Steam/steamapps/workshop/content/431960"; do
    [[ -d "$c" ]] && { echo "$c"; return 0; }
  done
  return 1
}
WORKSHOP="$(find_workshop || true)"

die() { echo "omarchy-we: $*" >&2; exit 1; }
notify() { command -v omarchy-notification-send >/dev/null 2>&1 && omarchy-notification-send "$1" -t "${2:-2500}" || true; }

[[ -n "$WORKSHOP" ]] || die "no Wallpaper Engine workshop folder found (is Wallpaper Engine installed via Steam?)"

# ---- catalog ---------------------------------------------------------------
# Emits TSV rows: id \t type \t title   (sorted by title, one row per wallpaper)
catalog() {
  WORKSHOP="$WORKSHOP" python3 - <<'PY'
import json, os, sys
root = os.environ["WORKSHOP"]
rows = []
for entry in os.scandir(root):
    if not entry.is_dir():
        continue
    pj = os.path.join(entry.path, "project.json")
    typ, title = "?", entry.name
    if os.path.isfile(pj):
        try:
            d = json.load(open(pj, encoding="utf-8", errors="replace"))
            typ = str(d.get("type", "?")).lower()
            title = str(d.get("title", entry.name)).strip() or entry.name
        except Exception:
            pass
    rows.append((entry.name, typ, title))
rows.sort(key=lambda r: r[2].lower())
for wid, typ, title in rows:
    sys.stdout.write(f"{wid}\t{typ}\t{title}\n")
PY
}

# Resolve a query (index number | workshop id | title substring) to a workshop id.
resolve_id() {
  local query="$1"
  # exact id (workshop numeric id, or any folder name — e.g. a hand-made
  # video wallpaper); this is what the picker / ipc hand back
  if [[ "$query" != *"/"* && -d "$WORKSHOP/$query" ]]; then
    echo "$query"; return 0
  fi
  # 1-based list index
  if [[ "$query" =~ ^[0-9]+$ ]]; then
    catalog | awk -F'\t' -v n="$query" 'NR==n{print $1}'
    return 0
  fi
  # case-insensitive title substring (first match)
  catalog | awk -F'\t' -v q="${query,,}" 'BEGIN{IGNORECASE=1} index(tolower($3), q){print $1; exit}'
}

title_of() { catalog | awk -F'\t' -v id="$1" '$1==id{print $3; exit}'; }

# ---- machine-readable output (IPC surface for bars / plugins) ---------------
# JSON array of every wallpaper: {id,title,type,preview,current}. `preview` is
# an absolute path to the wallpaper's own preview image (or null).
entries_json() {
  local cur; cur="$(cat "$STATE_FILE" 2>/dev/null || true)"
  WORKSHOP="$WORKSHOP" CURRENT_ID="$cur" python3 - <<'PY'
import json, os, glob, sys
root = os.environ["WORKSHOP"]; cur = os.environ.get("CURRENT_ID", "")
EXTS = ("jpg", "jpeg", "png", "gif", "bmp", "webp")
out = []
for entry in os.scandir(root):
    if not entry.is_dir():
        continue
    pj = os.path.join(entry.path, "project.json")
    typ, title, prev = "?", entry.name, None
    if os.path.isfile(pj):
        try:
            d = json.load(open(pj, encoding="utf-8", errors="replace"))
            typ = str(d.get("type", "?")).lower()
            title = str(d.get("title", "")).strip() or entry.name
            p = str(d.get("preview", "")).strip()
            if p and os.path.isfile(os.path.join(entry.path, p)):
                prev = os.path.join(entry.path, p)
        except Exception:
            pass
    if not prev:
        c = sorted(g for g in glob.glob(os.path.join(entry.path, "preview.*"))
                   if g.rsplit(".", 1)[-1].lower() in EXTS)
        prev = c[0] if c else None
    out.append({"id": entry.name, "title": title, "type": typ,
                "preview": prev, "current": entry.name == cur})
out.sort(key=lambda r: r["title"].lower())
json.dump(out, sys.stdout, ensure_ascii=False, indent=2)
sys.stdout.write("\n")
PY
}

# JSON object for the current selection: {id,title,type,preview,running}.
current_json() {
  local id running=false
  id="$(cat "$STATE_FILE" 2>/dev/null || true)"
  if pgrep -f "${WE_BIN}[^ ]* .*--screen-root" >/dev/null 2>&1; then running=true; fi
  ID="$id" RUNNING="$running" WORKSHOP="$WORKSHOP" python3 - <<'PY'
import json, os, glob, sys
wid = os.environ.get("ID", ""); running = os.environ.get("RUNNING") == "true"
root = os.environ["WORKSHOP"]
EXTS = ("jpg", "jpeg", "png", "gif", "bmp", "webp")
title = typ = prev = None
if wid:
    p = os.path.join(root, wid); pj = os.path.join(p, "project.json")
    if os.path.isfile(pj):
        try:
            d = json.load(open(pj, encoding="utf-8", errors="replace"))
            typ = str(d.get("type", "?")).lower()
            title = str(d.get("title", "")).strip() or wid
            pv = str(d.get("preview", "")).strip()
            if pv and os.path.isfile(os.path.join(p, pv)):
                prev = os.path.join(p, pv)
        except Exception:
            pass
    if prev is None:
        c = sorted(g for g in glob.glob(os.path.join(p, "preview.*"))
                   if g.rsplit(".", 1)[-1].lower() in EXTS)
        prev = c[0] if c else None
json.dump({"id": wid or None, "title": title, "type": typ,
           "preview": prev, "running": running}, sys.stdout, ensure_ascii=False)
sys.stdout.write("\n")
PY
}

# Build a directory of preview images (symlinks named by a readable, unique
# label) for the native Quickshell image selector, plus a label->id map.
build_previews() {
  mkdir -p "$PREVIEW_DIR" "$(dirname "$MAP_FILE")"
  WORKSHOP="$WORKSHOP" PREVIEW_DIR="$PREVIEW_DIR" MAP_FILE="$MAP_FILE" python3 - <<'PY'
import json, os, glob
from collections import Counter
root = os.environ["WORKSHOP"]; pdir = os.environ["PREVIEW_DIR"]; mapf = os.environ["MAP_FILE"]
EXTS = ("jpg", "jpeg", "png", "gif", "bmp", "webp")

# Drop stale entries so removed subscriptions disappear from the picker.
for e in os.scandir(pdir):
    if e.is_symlink() or e.is_file():
        try: os.remove(e.path)
        except OSError: pass

items = []  # (id, type, title, preview_path, ext)
for entry in os.scandir(root):
    if not entry.is_dir():
        continue
    pj = os.path.join(entry.path, "project.json")
    typ, title, prev = "?", entry.name, None
    if os.path.isfile(pj):
        try:
            d = json.load(open(pj, encoding="utf-8", errors="replace"))
            typ = str(d.get("type", "?")).lower()
            title = str(d.get("title", "")).strip() or entry.name
            p = str(d.get("preview", "")).strip()
            if p and os.path.isfile(os.path.join(entry.path, p)):
                prev = os.path.join(entry.path, p)
        except Exception:
            pass
    if not prev:
        cands = sorted(glob.glob(os.path.join(entry.path, "preview.*")))
        prev = cands[0] if cands else None
    if not prev:
        continue
    ext = os.path.splitext(prev)[1].lstrip(".").lower()
    if ext not in EXTS:
        continue
    items.append((entry.name, typ, title, prev, ext))

items.sort(key=lambda r: r[2].lower())
dup = Counter(r[2] for r in items)          # titles shared by >1 wallpaper
used, rows = {}, []
for wid, typ, title, prev, ext in items:
    label = f"{title} ({typ})" if dup[title] > 1 else title
    label = label.replace("/", "-").replace("\n", " ").strip()
    base, n = label, 2
    while label in used:                    # guarantee uniqueness
        label = f"{base} ({n})"; n += 1
    used[label] = wid
    link = os.path.join(pdir, f"{label}.{ext}")
    try:
        if os.path.lexists(link): os.remove(link)
        os.symlink(prev, link)
    except OSError:
        continue
    rows.append((label, wid))

with open(mapf, "w", encoding="utf-8") as f:
    for label, wid in rows:
        f.write(f"{label}\t{wid}\n")
PY
}

# Append a synthetic "Stop" tile to the picker: a generated thumbnail whose
# label sorts last, mapped to a sentinel that cmd_menu turns into a stop.
# build_previews has already cleared PREVIEW_DIR and written MAP_FILE, so this
# runs after it. No-op without magick (the tile can't be drawn); the grid still
# works, just without a stop tile.
add_stop_tile() {
  command -v magick >/dev/null 2>&1 || return 0
  local img="$PREVIEW_DIR/$STOP_LABEL.png"
  magick -size 640x360 xc:'#181818' \
    -fill '#d64545' -draw 'roundrectangle 270,120 370,240 14,14' \
    -fill '#dddddd' -gravity south -pointsize 30 -annotate +0+28 'Stop Live Wallpaper' \
    "$img" 2>/dev/null || return 0
  printf '%s\t%s\n' "$STOP_LABEL" "$STOP_SENTINEL" >> "$MAP_FILE"
}

# ---- background handling ---------------------------------------------------
ensure_transparent_asset() {
  if [[ ! -f "$TRANSPARENT_BG" ]]; then
    mkdir -p "$(dirname "$TRANSPARENT_BG")"
    if command -v magick >/dev/null 2>&1; then
      magick -size 1920x1080 xc:none "$TRANSPARENT_BG"
    else
      # 1x1 transparent PNG fallback (base64)
      base64 -d > "$TRANSPARENT_BG" <<'B64'
iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYPhfDwAChwGA60e6kgAAAABJRU5ErkJggg==
B64
    fi
  fi
}

# Point Omarchy's Quickshell background at the transparent image so the live
# wallpaper below it is visible.
clear_omarchy_background() {
  ensure_transparent_asset
  omarchy-theme-bg-set "$TRANSPARENT_BG" >/dev/null 2>&1 || \
    ln -nsf "$TRANSPARENT_BG" "$HOME/.local/state/omarchy/current/background"
}

# ---- linux-wallpaperengine -------------------------------------------------
# All currently-active monitor names, one per line. hyprctl monitors lists only
# enabled outputs, so disabled screens are correctly skipped.
detect_screens() {
  hyprctl monitors -j 2>/dev/null | python3 -c '
import json,sys
try: ms=json.load(sys.stdin)
except Exception: ms=[]
for m in ms:
    n=m.get("name","")
    if n: print(n)
' 2>/dev/null
}

# Stop only our own wallpaper instances. Matching the full invocation (binary
# + --screen-root) rather than the bare binary name avoids killing unrelated
# processes that merely mention "linux-wallpaperengine" in their command line.
# linux-wallpaperengine's main loop blocks in wl_display_dispatch and stops
# getting frame callbacks once another layer covers it, so SIGTERM alone can
# leave a zombie renderer stacked underneath, still burning GPU. Escalate.
stop_we() {
  local pat="${WE_BIN}[^ ]* .*--screen-root" i
  pkill -TERM -f "$pat" 2>/dev/null || return 0
  for i in 1 2 3 4 5; do
    pgrep -f "$pat" >/dev/null 2>&1 || return 0
    sleep 0.2
  done
  pkill -KILL -f "$pat" 2>/dev/null || true
}

# ---- per-monitor overrides --------------------------------------------------
# $SCREENS_FILE holds "monitor<TAB>id" lines. Empty/missing means every
# monitor shows the globally selected wallpaper.
screen_override() { [[ -f "$SCREENS_FILE" ]] && awk -F'\t' -v m="$1" '$1==m{print $2; exit}' "$SCREENS_FILE"; true; }

focused_screen() { hyprctl monitors -j 2>/dev/null | jq -r 'first(.[] | select(.focused)) | .name' 2>/dev/null; }

# Effective wallpaper for a monitor: its pin, else the global choice.
effective_id() { local o; o="$(screen_override "$1")"; [[ -n "$o" ]] && echo "$o" || cat "$STATE_FILE" 2>/dev/null || true; }

pin_screen() {  # pin_screen <monitor> <id>   (id empty = unpin)
  mkdir -p "$STATE_DIR"; touch "$SCREENS_FILE"
  local tmp; tmp="$(mktemp)"
  awk -F'\t' -v m="$1" '$1!=m' "$SCREENS_FILE" > "$tmp"
  [[ -n "${2:-}" ]] && printf '%s\t%s\n' "$1" "$2" >> "$tmp"
  mv "$tmp" "$SCREENS_FILE"
}

# apply_id <id> [--all | --screen <monitor>]
# Default scope ($SCOPE) is the focused monitor: only that output changes and
# the choice is stored as a pin. --all makes every monitor show it and drops
# all pins.
apply_id() {
  local id="$1" scope="${2:-}" mon="${3:-}"
  if [[ -z "$scope" ]]; then
    [[ "$SCOPE" == "all" ]] && scope=--all || scope=--screen
  fi
  if [[ "$scope" == "--all" ]]; then
    rm -f "$SCREENS_FILE"
    launch_we "$id"
    echo "Set wallpaper: $(title_of "$id")  [$id]  (all monitors)"
    notify "Wallpaper: $(title_of "$id")"
    return 0
  fi
  [[ -n "$mon" ]] || mon="$(focused_screen)"
  if [[ -z "$mon" ]]; then launch_we "$id"; echo "Set wallpaper: $(title_of "$id")  [$id]"; return 0; fi
  pin_screen "$mon" "$id"
  cmd_launch
  echo "Set wallpaper on $mon: $(title_of "$id")  [$id]"
  notify "$mon: $(title_of "$id")"
}

# parse_scope "$@" -> sets SCOPE_ARG / SCOPE_MON, and SCOPE_REST to the first
# remaining (non-option) argument.
parse_scope() {
  SCOPE_ARG=""; SCOPE_MON=""; SCOPE_REST=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --all)     SCOPE_ARG=--all; shift;;
      --screen)  SCOPE_ARG=--screen; SCOPE_MON="${2:-}"; shift 2;;
      *)         break;;
    esac
  done
  SCOPE_REST="${1:-}"
}

cmd_screen() {
  local mon="${1:-}" query="${2:-}"
  if [[ -z "$mon" || "$mon" == "list" ]]; then
    local s
    for s in $(detect_screens); do
      local o; o="$(screen_override "$s")"
      if [[ -n "$o" ]]; then printf '%-10s %s  [%s]\n' "$s" "$(title_of "$o")" "$o"; else printf '%-10s (follows set)\n' "$s"; fi
    done
    return 0
  fi
  [[ -n "$query" ]] || die "usage: omarchy-we screen <monitor> <index|id|title|clear>"
  if [[ "$query" == "clear" || "$query" == "--" ]]; then
    pin_screen "$mon" ""
  else
    local id; id="$(resolve_id "$query")"
    [[ -n "$id" ]] || die "no wallpaper matched '$query' (try: omarchy-we list)"
    pin_screen "$mon" "$id"
  fi
  cmd_launch
}

launch_we() {
  local id="$1"
  command -v "$WE_BIN" >/dev/null 2>&1 || die "$WE_BIN is not installed (yay -S linux-wallpaperengine-git)"
  [[ -d "$WORKSHOP/$id" ]] || die "wallpaper id '$id' not found in $WORKSHOP"

  local screens; mapfile -t screens < <(detect_screens)
  [[ ${#screens[@]} -gt 0 ]] || die "could not detect a monitor (is Hyprland running?)"

  rm -f "$STOPPED_FILE"
  stop_we; sleep 0.3
  clear_omarchy_background

  # One process drives every monitor: repeat a per-screen group so each active
  # output gets the same wallpaper. --scaling binds to the preceding --screen-root.
  local args=(--silent)
  [[ -n "$FPS" ]] && args+=(--fps "$FPS")
  # Per-monitor overrides (omarchy-we screen <monitor> <query>) win over the
  # global choice; a monitor without one follows `set`.
  local s sid
  for s in "${screens[@]}"; do
    sid="$(screen_override "$s")"
    [[ -n "$sid" && -d "$WORKSHOP/$sid" ]] || sid="$id"
    args+=(--screen-root "$s" --bg "$WORKSHOP/$sid" --scaling "$SCALING")
  done

  # Detach fully so it survives this shell; wrap with uwsm-app to match Omarchy.
  setsid -f uwsm-app -- "$WE_BIN" "${args[@]}" >/dev/null 2>&1 || \
    setsid -f "$WE_BIN" "${args[@]}" >/dev/null 2>&1

  echo "$id" > "$STATE_FILE"
}

# ---- commands --------------------------------------------------------------
cmd_list() {
  local i=1 id typ title
  printf "%-4s %-7s %-40s %s\n" "#" "TYPE" "TITLE" "ID"
  while IFS=$'\t' read -r id typ title; do
    printf "%-4s %-7s %-40.40s %s\n" "$i" "$typ" "$title" "$id"
    i=$((i+1))
  done < <(catalog)
}

cmd_set() {
  parse_scope "$@"; local query="$SCOPE_REST"
  [[ -n "$query" ]] || die "usage: omarchy-we set [--all | --screen <monitor>] <index|id|title>"
  local id; id="$(resolve_id "$query")"
  [[ -n "$id" ]] || die "no wallpaper matched '$query' (try: omarchy-we list)"
  apply_id "$id" "$SCOPE_ARG" "$SCOPE_MON"
}

# Used by autostart and the theme-set hook: a no-op while stopped, so a
# theme change or login does not resurrect a wallpaper the user turned off.
cmd_launch() {
  if [[ -e "$STOPPED_FILE" ]]; then
    echo "Live wallpaper is stopped (omarchy-we resume, or pick a wallpaper, to bring it back)."
    return 0
  fi
  local id; id="$(cat "$STATE_FILE" 2>/dev/null || true)"
  if [[ -z "$id" ]]; then
    # No saved choice yet: pick the first wallpaper.
    id="$(catalog | awk -F'\t' 'NR==1{print $1}')"
    [[ -n "$id" ]] || die "no wallpapers available"
  fi
  launch_we "$id"
}

cmd_cycle() {
  local dir="$1"; shift; local cur idx total
  parse_scope "$@"
  mapfile -t IDS < <(catalog | cut -f1)
  total=${#IDS[@]}; [[ $total -gt 0 ]] || die "no wallpapers available"
  # Cycle from what the target monitor currently shows (its pin, else global).
  local mon=""
  case "${SCOPE_ARG:-$SCOPE}" in
    --all|all) ;;
    --screen)  mon="$SCOPE_MON";;
    *)         mon="$(focused_screen)";;
  esac
  if [[ -n "$mon" ]]; then cur="$(effective_id "$mon")"; else cur="$(cat "$STATE_FILE" 2>/dev/null || true)"; fi
  idx=-1
  for i in "${!IDS[@]}"; do [[ "${IDS[$i]}" == "$cur" ]] && idx=$i && break; done
  case "$dir" in
    next)   idx=$(( (idx + 1) % total ));;
    prev)   idx=$(( (idx - 1 + total) % total ));;
    random) idx=$(( RANDOM % total ));;
  esac
  apply_id "${IDS[$idx]}" "$SCOPE_ARG" "$SCOPE_MON"
}

# Omatrix: the semicircular dial overlay (only available when installed as a
# registered plugin). Falls back to the grid picker when the overlay can't be
# summoned (e.g. a plain ./install.sh dev install, or a non-Omarchy shell).
OMATRIX_ID="io.github.dkgamer02ai.wallpaper-engine"
cmd_omatrix() {
  if command -v omarchy-shell >/dev/null 2>&1 \
     && omarchy-shell shell summon "$OMATRIX_ID" '{}' >/dev/null 2>&1; then
    return 0
  fi
  cmd_menu
}

# Native Omarchy Quickshell thumbnail picker (same UI as the built-in
# background switcher). Falls back to a text menu if it isn't available.
cmd_menu() {
  if command -v omarchy-menu-images >/dev/null 2>&1 && command -v omarchy-shell >/dev/null 2>&1; then
    build_previews
    [[ -s "$MAP_FILE" ]] || die "no wallpaper previews found"
    add_stop_tile                                    # a "Stop" tile as the last grid item

    # Mark the current wallpaper as selected in the grid.
    local cur sel="" lbl
    cur="$(cat "$STATE_FILE" 2>/dev/null || true)"
    if [[ -n "$cur" ]]; then
      lbl="$(awk -F'\t' -v id="$cur" '$2==id{print $1; exit}' "$MAP_FILE")"
      [[ -n "$lbl" ]] && sel="$(find -L "$PREVIEW_DIR" -maxdepth 1 -name "$lbl.*" -print -quit 2>/dev/null)"
    fi

    local args=(--print-name --show-labels --filterable --lazy-thumbnails)
    [[ -n "$sel" ]] && args+=(--selected "$sel")

    # LC_ALL=C so the picker sorts tile filenames by byte, not glibc collation
    # (which ignores the leading symbol and would file the ⏹ tile mid-grid under
    # "S"). Byte order puts the ⏹ tile (0xE2…) after every ASCII title, i.e.
    # last. Labels reach the UI as base64, so the locale only affects the sort.
    local name id
    name="$(LC_ALL=C omarchy-menu-images "${args[@]}" "$PREVIEW_DIR")"
    [[ -n "$name" ]] || exit 0                       # cancelled
    id="$(awk -F'\t' -v n="$name" '$1==n{print $2; exit}' "$MAP_FILE")"
    [[ -n "$id" ]] || die "could not map selection '$name' to a wallpaper"
    [[ "$id" == "$STOP_SENTINEL" ]] && { cmd_stop; return 0; }
    launch_we "$id"
    notify "Wallpaper: $(title_of "$id")"
    echo "Set wallpaper: $(title_of "$id")  [$id]"
    return 0
  fi

  # Fallback: text dmenu. On walker, -H hides the F1–F4 quick-activation
  # buttons so Enter is the only selection path.
  local menu chosen
  for m in walker fuzzel wofi rofi; do command -v "$m" >/dev/null 2>&1 && { menu="$m"; break; }; done
  [[ -n "${menu:-}" ]] || die "no picker found (need omarchy-menu-images or walker/fuzzel/wofi/rofi)"
  local input; input="$(catalog | awk -F'\t' '{printf "%s  ·  %s\n", $3, $2}')"
  case "$menu" in
    walker) chosen="$(printf '%s\n' "$input" | walker --dmenu -H -p 'Wallpaper')";;
    fuzzel) chosen="$(printf '%s\n' "$input" | fuzzel --dmenu -p 'Wallpaper: ')";;
    wofi)   chosen="$(printf '%s\n' "$input" | wofi --dmenu -p 'Wallpaper')";;
    rofi)   chosen="$(printf '%s\n' "$input" | rofi -dmenu -p 'Wallpaper')";;
  esac
  [[ -n "${chosen:-}" ]] || exit 0
  cmd_set "${chosen%%  ·  *}"
}

cmd_current() {
  local id; id="$(cat "$STATE_FILE" 2>/dev/null || true)"
  [[ -n "$id" ]] || { echo "No live wallpaper set."; return 0; }
  echo "$(title_of "$id")  [$id]"
  # Match our own instance (binary + --screen-root), not any process that merely
  # mentions the binary name — same guard as stop_we/current_json.
  pgrep -f "${WE_BIN}[^ ]* .*--screen-root" >/dev/null 2>&1 && echo "Status: running" || echo "Status: not running"
  [[ -s "$SCREENS_FILE" ]] && { echo "Pinned:"; cmd_screen list | grep -v '(follows set)' | sed 's/^/  /'; }
  true
}

cmd_resume() { rm -f "$STOPPED_FILE"; cmd_launch; }

cmd_stop() {
  stop_we
  mkdir -p "$STATE_DIR"; touch "$STOPPED_FILE"
  # Restore a normal, opaque Omarchy background from the current theme.
  local bg
  bg="$(find -L "$HOME/.local/state/omarchy/current/theme/backgrounds" -maxdepth 1 -type f \
        \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) 2>/dev/null | sort | head -1)"
  if [[ -n "$bg" ]]; then
    omarchy-theme-bg-set "$bg" >/dev/null 2>&1 || true
    echo "Stopped live wallpaper; restored theme background."
  else
    echo "Stopped live wallpaper. (No theme background found to restore.)"
  fi
}

# Stable IPC surface for bars / shell plugins. Mirrors the "ipc <verb>" shape
# a bar already uses, e.g.  omarchy-we ipc picker  /  omarchy-we ipc entries.
# Capability/version contract for third-party integrations (bars/plugins).
# Bump WE_IPC_VERSION only on a breaking change to the ipc JSON shapes.
WE_IPC_VERSION=1
cmd_ipc() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    version)      printf '{"ipc":%s,"tool":"omarchy-we","commands":["version","entries","current","set","stop","picker"]}\n' "$WE_IPC_VERSION";;
    entries)      entries_json;;                    # JSON list of all wallpapers
    current)      current_json;;                    # JSON of the active wallpaper
    set)          cmd_set "${1:-}";;                # apply by id/index/title
    picker|menu)  cmd_menu;;                        # open the thumbnail picker
    stop)         cmd_stop;;                        # stop the live wallpaper + restore a static bg
    kill)         stop_we;;                         # stop ONLY the renderer (caller sets the bg)
    ""|-h|--help) echo "usage: omarchy-we ipc {version|picker|entries|current|set <id>|stop|kill}";;
    *)            die "unknown ipc verb '$sub' (try: omarchy-we ipc --help)";;
  esac
}

# ---- dispatch --------------------------------------------------------------
case "${1:-}" in
  list)                 shift; [[ "${1:-}" == "--json" ]] && entries_json || cmd_list;;
  set)                  shift; cmd_set "$@";;
  menu)                 cmd_menu;;
  omatrix)              cmd_omatrix;;
  next|prev|random)     cmd_cycle "$@";;
  launch)               cmd_launch;;
  current)              shift; [[ "${1:-}" == "--json" ]] && current_json || cmd_current;;
  stop)                 cmd_stop;;
  resume)               cmd_resume;;
  screen)               shift; cmd_screen "$@";;
  ipc)                  shift; cmd_ipc "$@";;
  ""|-h|--help|help)
    sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//';;
  *) die "unknown command '$1' (try: omarchy-we help)";;
esac
